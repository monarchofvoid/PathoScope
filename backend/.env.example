# Application Settings
APP_NAME=PathoScope
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://pathoscope:password@localhost:5432/pathoscope_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Settings
ALLOWED_HOSTS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@pathoscope.hospital

# SMS Gateway Configuration (Optional)
SMS_GATEWAY_URL=https://api.twilio.com/2010-04-01/Accounts
SMS_API_KEY=your-twilio-api-key

# TEK Distribution Server Configuration
TEK_DISTRIBUTION_URL=https://tek-distribution.hospital.gov/api
TEK_API_KEY=your-tek-api-key

# Security Settings
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
VERIFICATION_TOKEN_LENGTH=32
TOKEN_EXPIRE_HOURS=72

# Data Retention
TEK_RETENTION_DAYS=14
AUDIT_LOG_RETENTION_DAYS=365

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15